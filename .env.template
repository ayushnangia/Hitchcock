# Required API keys
SERPAPI_API_KEY=your_serpapi_key_here
HF_TOKEN=your_huggingface_token_here
ELEVEN_LABS_API_KEY=your_eleven_labs_key_here
FAL_KEY=your_fal_key_here
# LiteLLM configuration (optional)
OPENAI_API_KEY=your_openai_key_here  # If using OpenAI models
ANTHROPIC_API_KEY=your_anthropic_key_here  # If using Anthropic models

# Optional: 60db cloud — TTS, LLM, and STT all share one key.
# Each service has its own provider switch so you can mix and match:
#   AUDIO_PROVIDER=sixtydb   → narration through 60db /tts-synthesize
#   LLM_PROVIDER=sixtydb     → script writer's LiteLLM routes to 60db
#   (STT has no default consumer in the pipeline yet — call
#    SixtyDbSTTService.transcribe() directly when you need it.)
AUDIO_PROVIDER=elevenlabs
LLM_PROVIDER=
SIXTYDB_API_KEY=your_sixtydb_key_here
# SIXTYDB_API_BASE=https://api.60db.ai
# SIXTYDB_TTS_VOICE_ID=fbb75ed2-975a-40c7-9e06-38e30524a9a1
# SIXTYDB_LLM_MODEL=60db-tiny
# SIXTYDB_STT_LANGUAGE=auto
